App(
    appid="bt",
    name="BtSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="bt_srv",
    cdefines=["SRV_BT"],
    requires=[
        "cli",
        "dialogs",
    ],
    provides=[
        "cli_bt",
        "bt_settings",
    ],
    # The CLI command ships as a separate .fal - keep its source out of the service image.
    sources=["*.c*", "!bt_cli.c"],
    stack_size=1 * 1024,
    order=20,
    sdk_headers=[
        "bt_service/bt.h",
        "bt_service/bt_keys_storage.h",
        "bt_settings.h",
        "bt_service/bt_settings_api_i.h",
    ],
)

App(
    appid="cli_bt",
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_bt_ep",
    requires=["cli"],
    sources=["bt_cli.c"],
)
